# Copie ce fichier en .env.local (jamais envoyé sur GitHub) et remplis-le.
# Les valeurs se trouvent dans Supabase > Project Settings > API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Étape 3 : clé secrète Supabase (Vercel : type Sensitive)
SUPABASE_SECRET_KEY=
# Étape 7 : notifications (à fabriquer depuis la page « Installer et notifications »)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
